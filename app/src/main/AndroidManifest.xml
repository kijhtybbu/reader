<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Removing DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION, which is not used -->
    <!-- fork: rebase-critical — 这三条靠名字精确匹配 applicationId（dev.jia.reader / .debug /
         .release.debug）才生效，名字对上时才 remove 成功，对不上不报错。详见 REBASE.md 第 2 节 -->
    <uses-permission
        android:name="dev.jia.reader.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="dev.jia.reader.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="dev.jia.reader.release.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- Removing READ_EXTERNAL_STORAGE and WRITE_EXTERNAL_STORAGE explicitly -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"
        tools:ignore="ScopedStorage" />

    <!-- fork: Android 11+ package visibility: TextToSpeech engine discovery needs this. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".Application"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Splash"
        tools:ignore="DataExtractionRules"
        tools:targetApi="tiramisu">

        <!-- Main activity -->
        <activity
            android:name=".presentation.main.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|density|uiMode"
            android:exported="true"
            android:theme="@style/Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- fork: rebase-critical — Android 16 起，targetSdk 36 的应用在最小宽度≥600dp 的屏幕上
                 会被忽略 screenOrientation / setRequestedOrientation()，即阅读页「屏幕方向」六个选项
                 （含锁定竖屏）在平板上全部失效。这条 opt-out 让它们恢复生效；Android 17（API 37）
                 已删除该 opt-out，抬 targetSdk 前必须先换掉大屏上的方向 UI。详见 PROGRESS.md §3.17、
                 REBASE.md §4，ReaderOrientationManifestTest 钉住。 -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>

        <!-- Crash activity -->
        <activity
            android:name=".presentation.crash.CrashActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|density|uiMode"
            android:exported="false"
            android:theme="@style/BookStory"
            android:windowSoftInputMode="adjustResize" />

        <!-- Save app locales -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>